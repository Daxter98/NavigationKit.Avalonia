<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sample="clr-namespace:NavKit.ReactiveUI.Sample"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="NavKit.ReactiveUI.Sample.MainWindow"
        x:DataType="sample:MainViewModel"
        Title="NavKit.ReactiveUI.Sample">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#12263A"
                BorderBrush="#1E3A5F"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                <TextBlock Grid.Column="0"
                           FontSize="11"
                           Opacity="0.8"
                           x:Name="LastActionTextBlock"
                           Foreground="#C5D8EE" />

                <Border Grid.Column="1"
                        Background="#20466D"
                        CornerRadius="999"
                        Padding="10,4"
                        VerticalAlignment="Center">

                    <TextBlock x:Name="NavigationDepthTextBlock"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#EAF4FF" />
                </Border>
            </Grid>
        </Border>
        
        <NavigationPage x:Name="NavigationRoot" />
    </DockPanel>
</Window>