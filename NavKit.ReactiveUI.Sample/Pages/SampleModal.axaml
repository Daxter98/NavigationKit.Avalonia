<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:NavKit.ReactiveUI.Sample.ViewModels"
             x:Class="NavKit.ReactiveUI.Sample.Pages.SampleModal"
             NavigationPage.HasNavigationBar="False"
             x:DataType="viewModels:SampleModalViewModel"
             Header="SampleModal">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <TextBlock Text="This is a Sample Modal" FontSize="24" HorizontalAlignment="Center" />

        <TextBox PlaceholderText="Enter your name here!" x:Name="NameTextBox" />

        <StackPanel Orientation="Horizontal" Spacing="20">
            <Button Content="Ok" x:Name="ConfirmButton" />
            <Button Content="Cancel" x:Name="CancelButton" />
        </StackPanel>

    </StackPanel>
</ContentPage>