<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:NavKit.ReactiveUI.Sample.ViewModels"
             x:Class="NavKit.ReactiveUI.Sample.Pages.Page2"
             x:DataType="viewModels:Page2Vm"
             Header="Page 2">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
        <TextBlock Text="This is Page2." FontSize="24" HorizontalAlignment="Center" />

        <Button Content="Open Username Modal" x:Name="ModalButton" />

        <TextBlock FontWeight="Bold" x:Name="ResultTextBlock" />

        <TextBlock Foreground="Red" x:Name="ExceptionsTextBlock"></TextBlock>
    </StackPanel>
</ContentPage>